DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ciaorelated?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
HOST="0.0.0.0"
PORT="4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
CLIENT_ORIGIN="http://localhost:3000"
CURRENT_TERMS_VERSION="1"
NOMINATIM_EMAIL=""

SENDGRID_API_KEY=""
EMAIL_FROM="ciaorelated <noreply@example.com>"

# Phone login / registration with Twilio Verify.
# If these are empty, development logs SMS codes to the server console.
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# S3-compatible object storage for media uploads.
# Works with AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO, etc.
S3_BUCKET=""
S3_REGION="eu-north-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE=""
SIGNED_URL_TTL_SECONDS="900"

# Legacy AWS-style names used by some helpers.
AWS_REGION="eu-north-1"
AWS_S3_BUCKET=""

# Upload limits.
MAX_AVATAR_BYTES="5242880"
MAX_UPLOAD_BYTES="104857600"
MAX_POST_IMAGE_BYTES="10485760"
MAX_POST_VIDEO_BYTES="104857600"
MAX_STORY_UPLOAD_BYTES="83886080"

# Optional background workers.
ENABLE_VIDEO_WORKER="false"
ENABLE_IMAGE_WORKER="false"
ENABLE_STORY_WORKER="false"
ENABLE_AVATAR_WORKER="false"
ENABLE_VLOG_COVER_WORKER="false"
ENABLE_DAILY_DIGEST="false"

# Optional worker tooling.
TMPDIR=""
FFMPEG_PATH="/usr/local/bin/ffmpeg"
FFPROBE_PATH="/usr/local/bin/ffprobe"
