{
  "name": "ciaorelated",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "pnpm -r --filter @ig/shared build",
    "dev:shared": "pnpm --filter @ig/shared build --watch",
    "dev:server": "pnpm --filter server dev",
    "dev:mobile": "pnpm --filter ciaorelated start",
    "dev": "concurrently -n shared,server,mobile -c yellow,green,blue \"pnpm dev:shared\" \"pnpm dev:server\" \"pnpm dev:mobile\"",
    "eas-build-pre-install": "gem uninstall cocoapods -a -x || true && gem install cocoapods -v 1.15.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "concurrently": "^9.0.0",
    "metro": "^0.82.0",
    "metro-config": "^0.82.0",
    "metro-resolver": "^0.82.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "metro-resolver": "^0.82.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.5",
      "metro": "0.83.1",
      "metro-config": "0.83.1",
      "metro-core": "0.83.1",
      "@types/react": "~19.1.10",
      "@types/react-dom": "~19.1.7"
    }
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "expo": "~54.0.31",
    "expo-modules-autolinking": "^2.1.14",
    "expo-modules-core": "~2.5.0",
    "formdata-polyfill": "^4.0.10",
    "react-native-reanimated": "^4.2.1",
    "react-native-worklets": "^0.7.1",
    "react-native-worklets-core": "^1.6.2",
    "web-streams-polyfill": "^4.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
